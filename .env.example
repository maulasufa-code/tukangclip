# TukangClip — Fase 1: fondasi web + data
# Salin ke .env.local di apps/web untuk lokal. Jangan commit file .env asli.

# Supabase (dapat dari dashboard Supabase)
NEXT_PUBLIC_SUPABASE_URL=http://localhost:54321
NEXT_PUBLIC_SUPABASE_ANON_KEY=isi-anon-key-lokal
SUPABASE_SERVICE_ROLE_KEY=isi-service-role-hanya-di-server-jangan-ke-klien

# Cloudflare R2 (S3 compatible)
R2_ACCOUNT_ID=isi-account-id
R2_ACCESS_KEY_ID=isi-access-key
R2_SECRET_ACCESS_KEY=isi-secret-key
R2_BUCKET_RAW=tukangclip-raw
R2_PUBLIC_BASE_URL=https://isi-r2-public-base-url

# Batas MVP Fase 1 (disepakati: 30 menit, 2GB)
MAX_UPLOAD_BYTES=2147483648
MAX_VIDEO_MINUTES=30
